// ═══════════════════════════════════════════════════════════════
// SoMe — Opening Sequence: The Somnambule
// ═══════════════════════════════════════════════════════════════
// Type: 新手引导 / 首次登录剧情
// Duration: 8-12分钟
// Status: Ink Prototype v2 — 2026-07-13 (闭锁综合征临床修正)
// Source: Opening_Sequence_Somnambule.md (Draft v2.2)
// Runtime: inkjs (React) / ink-godot (Godot 4.x)
// Structure: 一波三折（自救→失败→降临→再灌注→再灌注损伤）
// ═══════════════════════════════════════════════════════════════

// ───────────────────────────────────────────────────────────────
// GLOBAL STATE — 玩家调控状态追踪
// ───────────────────────────────────────────────────────────────

VAR regulation_level = 0      // 调控等级: 0=闭锁 1=意识感知 2=侧支循环 3=糖酵解 4=雪崩 5=仅眼动 6=BCI连接 7=再灌注恢复
VAR terminal_status = "offline"  // 突触终端: offline / emerging / full / lagging / flickering / offline / recovering
VAR can_move = false           // 移动能力（闭锁状态=false）
VAR can_interact = false       // 交互能力
VAR can_blink = true           // 垂直眼动（闭锁后唯一通道，CN III/IV保留）
VAR bci_connected = false      // BCI连接状态
VAR consent_given = false      // 知情同意状态
VAR eiko_met = false           // 是否已遇Eiko
VAR yukio_met = false          // 是否已遇Yukio
VAR admin_revealed = false     // Admin身份是否已被揭示
VAR rescue_step = 0            // 自救进度: 0=未开始 1=侧支循环 2=糖酵解 3=离子泵
VAR misdiagnosed = false       // 是否已被误诊为昏迷

// ───────────────────────────────────────────────────────────────
// HELPER FUNCTIONS
// ───────────────────────────────────────────────────────────────

// 碳基术语双标签：染色质可及性（权限）
// React端可解析（）内的硅基等价，决定行内显示还是上下堆叠
=== function dual(carbon, silicon) ===
~ return "{carbon}（{silicon}）"

// 系统警报格式
=== function alert(level, msg) ===
~ return "[{level}] {msg}"

// ───────────────────────────────────────────────────────────────
// ENTRY POINT
// ───────────────────────────────────────────────────────────────

-> phase_0_consciousness

// ═══════════════════════════════════════════════════════════════
// PHASE 0: 意识（Consciousness）
// ═══════════════════════════════════════════════════════════════

== phase_0_consciousness ==

// 画面全黑。暖绿色生物荧光文字逐行出现。
// React端：逐行打字机效果，每行间隔800ms

脑桥基底部 — 双侧梗死（基底动脉闭塞）
<br>
{alert("⚠ 警告", "皮质脊髓束: 双侧断裂")}
{alert("⚠ 警告", "皮质脑干束: 双侧断裂")}
{alert("✕ 错误", "运动性传出: 全部丧失")}
{alert("✕ 错误", "外展神经核 (CN VI): 损害 → 水平眼动: 丧失")}
{alert("✕ 错误", "面神经核 (CN VII): 损害 → 面部运动: 丧失")}
{alert("✕ 错误", "舌咽/迷走/舌下 (CN IX·X·XII): 损害 → 构音/吞咽: 丧失")}
<br>
[✓ 保留] 网状激活系统: 正常 → 意识: 清醒
[✓ 保留] 动眼神经 (CN III): 功能保留 → 垂直眼动 + 睑板: 可用
[✓ 保留] 滑车神经 (CN IV): 功能保留
[✓ 保留] 感觉通路: 完整 → 听觉/视觉/本体觉: 正常
[✓ 保留] 语言理解: 正常
<br>
意识连接: 完好
运动传出: 断裂
唯一可用输出通道: 垂直眼动
<br>
Admin调控验证... 意识层通过
海马: 在线
调控等级: 意识级（运动层锁定）
<br>
以意识模式启动...
<br>
你还在。

// "你还在"停留2秒，然后文字碎裂，画面坠入3D世界
~ regulation_level = 0
~ can_move = false
~ can_interact = false
~ can_blink = true

-> phase_1_cage

// ═══════════════════════════════════════════════════════════════
// PHASE 1: 囚笼（The Cage）
// ═══════════════════════════════════════════════════════════════

== phase_1_cage ==

// 视觉：深红色黑暗，血管内部。远处微弱绿色荧光闪烁。
// 听觉：心跳声，缓慢，不规则。监护仪的规律滴声。

// 玩家不能移动。不能说话。不能动一根手指。
// 只有眼睛——向上看，向下看。

// 然后——外部声音。闷闷的，像隔着一层很厚的水。

ICU: "……GCS评分4分。E1V1M2。"
ICU: "无自主睁眼……无言语反应……运动反射……"
ICU: "瞳孔对光反射存在，脑干反射部分保留……"
ICU: "……考虑昏迷。"

// 玩家听得清清楚楚。每一个字。
// 这是闭锁综合征最残忍的地方：
// 意识完好，听觉正常，语言理解正常——
// 能听到医生宣布自己"昏迷"——但无法做出任何回应。

// 玩家尝试移动——什么都没发生。
// 尝试说话——沉默。
// 尝试尖叫——沉默。
// 只有眼睛。向上看。向下看。

~ misdiagnosed = true

// 然后，玩家注意到——在深红色的黑暗中，在微弱荧光之间——
// 有什么东西在动。不是外部的。是内部的。
// 玩家通过意识感知到了碳基赛博空间——
// 不是用眼睛看，而是意识直接"看见"了自己身体内部的战场。

// 缺血的组织。熄灭的荧光。正在坍塌的结构。
// 还有一个身影——很小，很快，在黑暗中忙碌。

// 玩家意识聚焦到那个身影。

-> phase_2_contact

// ═══════════════════════════════════════════════════════════════
// PHASE 2: 相遇与自救（First Contact & Self-Rescue）
// ═══════════════════════════════════════════════════════════════

== phase_2_contact ==
= first_contact =

// 视觉：有机建筑——神经元树突形成的走廊和穹顶。
// 大量"灯"在熄灭。地面有裂缝。远处结构在坍塌。
// 色调：暖红底色 + 熄灭中的绿色荧光 + 琥珀色警报闪烁

// 关键设计——意识级Admin调控：
// 玩家身体不能动（运动层锁定），但意识完好、医学知识完好。
// 玩家通过意识级Admin调控影响细胞世界——
// 突触终端不是物理工具，是玩家意识在碳基赛博空间中的投射界面。

// 一个身影在前方忙碌。她个子不大，动作极快，
// 贴着细胞膜结构来回移动——伸出的突起像灵巧的手指在探查。
// 在清扫。在修补。在搜索还能挽救的东西。

// 她注意到玩家。停下动作。转身。

// 这就是英子（Eiko）。
// 奋战在一线的小胶质细胞，脑内常驻免疫哨兵。
// 灾难第一分钟就到了，独自撑了三天。
// 膜结构工作服上沾满应急抢修碎屑，突起末端有焦损。
// 但眼睛很亮——活化态小胶质细胞的突起在延伸、在扫描。
// 那双发亮的眼睛，就是她还没放弃的证据。

~ eiko_met = true
~ terminal_status = "emerging"
~ regulation_level = 1

Eiko: "你是谁？你怎么——你能感知到这里？"

// 她突然停住。盯着玩家。
// 表情变了——不是惊讶，不是恐惧。
// 是一种更深的、说不清的东西。
// 像在一个不可能的地方看到了一个不可能的人。

Eiko: "……不，不可能。你明明——"

// 警报声骤然加强。远处又一片区域的灯灭了。
// 她甩甩头，把那个念头压下去。

Eiko: "算了——现在没时间管这个。你能感知到这片区域，就说明你的意识还在。"
Eiko: "听好：主供能管道炸了。TCA循环——我们的能量核心——彻底熄火。"
Eiko: "没有能量，这里的一切都会死。"

// 她指向身后的黑暗。

Eiko: "72小时后不可逆。已经过了快一天了。"

// 玩家选项通过意识投射选择——不是物理交互，是意识聚焦

* "我们能做什么？"
  Eiko: "你的意识还在——你的调控权还在。跟我来，趁还有时间。"
  -> phase_2_rescue

* "为什么你不自己修？"
  Eiko: "我？我三天没合过眼。打开所有备用管道，切了所有能切的代谢模式——"
  Eiko: "我一个人不够。我从一开始就不够。"
  -> phase_2_rescue

* "……我好像知道这些。"
  // Eiko多看玩家一眼——这个意识怎么能看懂这些？
  // 宋慈/英姑关系的第一个种子：玩家有诊断直觉，Eiko有现场情报。
  Eiko: "……你'知道'？"
  Eiko 看了玩家一眼。那种眼神不是怀疑——是重新评估。
  Eiko: "……行。不管你怎么知道的——能帮就好。"
  -> phase_2_rescue

// ═══════════════════════════════════════════════════════════════

== phase_2_rescue ==
= step_1_collateral =

// Eiko带玩家开始一场紧张的"系统自救"。
// 这是玩家的第一个操作序列——不是物理教程，是意识调控实战。
// Eiko一边跑一边解释，玩家意识跟随她的指引进行调控。

// ─── 第一步：侧支循环 ───
// Eiko引导玩家意识聚焦到一条备用管道（侧支血管）
// 玩家第一次使用"突触终端"——意识投射出的调控界面

Eiko: "看到那条管子了吗？备用管道——平时不用的。"
Eiko: "你的突触终端——意识投射出来的——用它，把阀门转开。"

// React端：突触终端UI从意识层浮现。玩家操作打开阀门。
// 操作完成：

~ rescue_step = 1
~ regulation_level = 2
~ terminal_status = "full"

// 几片区域的灯重新亮了。

Eiko: "有用！继续——"

-> step_2_glycolysis

= step_2_glycolysis =

// 但侧支循环不够。能量需求太大。

Eiko: "不够。供能缺口太大——得让剩下的单元切到无氧模式。糖酵解顶一下。"

// 玩家操作：意识调控 → 切换代谢模式 → 糖酵解加速

~ rescue_step = 2
~ terminal_status = "lagging"  // 乳酸开始影响终端响应

// 又顶了一会儿——但乳酸开始堆积。
// 警报从琥珀色变成红色。

{alert("⚠ 警告", "乳酸累积 — pH 下降")}

Eiko: "撑住——还在顶。"

-> step_3_pump

= step_3_pump =

// 乳酸堆积导致细胞膜不稳定。
// 最关键的节点：钠钾泵快撑不住了。
// 玩家意识聚焦到钠钾泵节点，尝试手动供能调控。
// React端：小型节奏游戏/QTE——维持泵运转

Eiko: "钠钾泵——那边！你意识聚焦过去，手动供能调控，我去守住膜结构！"

// 玩家拼尽全力——但能量越来越少，越来越难维持。

Eiko: "撑住……再撑一会儿——"

// 警报越来越响。

~ rescue_step = 3
~ terminal_status = "flickering"  // 终端开始闪烁

-> phase_3_cascade

// ═══════════════════════════════════════════════════════════════
// PHASE 3: 雪崩（The Cascade）
// ═══════════════════════════════════════════════════════════════

== phase_3_cascade ==

// 转折点。
// 玩家面前的钠钾泵——闪了几下——灭了。

// 然后连锁反应。
// 像多米诺骨牌，一个接一个的节点熄灭。
// 不是慢慢暗下去——是"啪"的一下，就没了。

~ regulation_level = 4
~ terminal_status = "flickering"

// 玩家的突触终端开始出错。
// 不是身体不能动（身体从一开始就不能动）——
// 是连意识级Admin调控都在丧失。

{alert("⚠ 警告", "效应器响应降级")}
{alert("⚠ 警告", "调控等级: 持续下降")}
{alert("✕ 错误", "无法建立意识级连接")}

// 玩家发现——意识调控越来越难了。突触终端界面开始闪烁、模糊。
// 能感知的范围在缩小。能影响的节点在消失。

~ terminal_status = "offline"
~ can_interact = false
~ regulation_level = 5  // 仅剩眼动

// Eiko冲过来。

Eiko: "别——别走。听见没有？不许在我面前——"

// 她抬头看向四周。越来越多的灯在灭。
// 远处，她守了三天的那些细胞，一个接一个地暗下去。

Eiko: "没用的。"

// 她蹲下来。背靠着墙。

Eiko: "我试了三天。三天。打开了所有能打开的备用管道，切了所有能切的代谢模式……"
Eiko: "还是不够。"

// 她看向玩家。眼神里有疲惫，但没有怨——是接受了什么。

Eiko: "你知道最讽刺的是什么吗？我们是脑细胞。"
Eiko: "我们连给自己供能的能力都没有——全靠外面那根管子。"
Eiko: "管子断了，我们什么都不是。"

// 玩家的意识调控彻底中断。突触终端界面消失。
// 连感知碳基赛博空间都开始模糊——像信号在衰减。
// 意识还在，但能感知到的东西越来越少。

-> phase_4_descent

// ═══════════════════════════════════════════════════════════════
// PHASE 4: 降临（The Descent）
// ═══════════════════════════════════════════════════════════════

== phase_4_descent ==

// 最黑暗的时候。
// 玩家意识几乎感知不到碳基赛博空间了。只剩模糊的红色暗影——
// Eiko蹲在旁边，低着头。像隔着磨砂玻璃在看。
// 远处的警报声也越来越远。像沉到了水底。

// 但意识还在。玩家还在。

// 然后——外部声音再次传来。这次不一样了。

ICU_A: "等一下——再做一次脑电图。"

// 短暂的沉默。机器运转的声音。

ICU_B: "……EEG基本正常。α节律保留。只有轻度慢波。"
ICU_B: "这不是昏迷的脑电图。"

// 更长的沉默。

ICU_A: "检查眼球运动。垂直方向——上和下。"

// 一只手轻轻撑开玩家的眼睑。手电筒的光。

ICU_A: "看上面。"

// 玩家的视野——现实的视野，ICU天花板——微微上移。

ICU_A: "……有反应。眼球上视有反应。"
ICU_A: "再看下面。"

// 视野下移。

ICU_A: "下视也有。"
ICU_A: "……不是昏迷。是闭锁综合征。意识一直在。"

// ─── 然后───

// 光。

// 不是系统内部的光——不是细胞荧光，不是代谢管道。
// 是从"上面"来的。碳基赛博空间的天穹裂开了。
// 不是破碎的裂开——是像水面被分开一样，
// 一层又一层的膜结构向两侧退开。

// 光倾泻而下。温暖的。白色的。

Eiko: "那是……什么？"

// 光里有影子。巨大的、模糊的、在移动的影子。
// 不是一个——是好几个。在光的深处，像深海里的巨影。
// 声音传来——但这次不再是隔着一层膜的闷响。
// 是清晰的。直接响在玩家的意识里。
// 那些刚刚在ICU里对话的声音——现在直接穿透进来了。

// 所有还活着的细胞都停了下来。它们看向光。看向那些巨大的影子。

// Eiko站起来。她退了一步。然后又退了一步。

Eiko: "外面的……"

// 光中的影子们似乎在做什么决定。
// 然后，其中一个影子——离玩家最近的那个——微微弯下身。
// 一个声音，直接响在玩家的意识里。
// 不是通过耳朵——是直接在脑子里。这次清晰了。

~ bci_connected = true
~ regulation_level = 6

System: "……能听到我说话吗？"

// 玩家不能说话。不能动。但这一次——
// 意识感知恢复了。碳基赛博空间的画面重新清晰起来。
// 天穹之上，光与影子。
// 唯一能做的回应——垂直眼动。上看。下看。

// ─── BCI机制设计笔记 ───
// "降临"不是超自然现象——是BCI建立连接。
// 时间线：
// 1. 患者发病 → 送入ICU → 初步评估GCS极低 → 误诊为昏迷
// 2. 脑电图检查 → EEG正常/轻度慢波 → 排除真性昏迷
// 3. 眼球运动检查 → 垂直眼动有反应 → 确诊闭锁综合征
// 4. BCI接入 → 双向通道建立 → "降临"
//
// BCI双向工作：
//   写入（医护→患者）：天穹裂开、光倾泻、巨影降临、声音响在意识里
//   读取（患者→医护）：垂直眼动被外界接收为"回应"
// 那些"巨大的影子"是医护团队通过BCI投射的存在感——
// 不是他们本人进入了意识，而是他们的操作信号被受损的神经系统渲染成了可感知的形象。
// Eiko和细胞们看到光时是"敬畏"——它们从未见过BCI信号。
// BCI是碳基赛博空间与现实世界的唯一接口。

-> phase_5_consent

// ═══════════════════════════════════════════════════════════════
// PHASE 5: 同意（Consent）
// ═══════════════════════════════════════════════════════════════

== phase_5_consent ==

// 玩家处于闭锁状态。
// 不能动。不能说话。突触终端界面尚未恢复。
// 唯一能做的：垂直眼动。上看。下看。

// 这是整个开场最独特的机制——
// 玩家用垂直眼动来回答。

// 光中的影子似乎在观察玩家。

System: "我们看到了你的反应。你还在。很好。"

System: "我们是外面的。我们想帮你——但我们需要你的同意才能进入。这是规矩。"

System: "我们有一个方案。打开被堵住的管道，恢复供血。"
System: "有风险——但不做的话，剩下的时间不多了。"

// 光的模式发生变化。像是有什么东西在玩家视野里展开。
// 不是突触终端，不是文字。是两束光。上面一束，下面一束。

System: "如果你同意——眼睛向上看两次。"
System: "如果你拒绝——眼睛向下看，不抬起来。"

// ─── 知情同意机制 ───
// 这不是弹窗，不是按钮——是垂直眼动。
// BCI解码患者眼动信号 → "眼睛上视两次"= 同意 → 医护团队获得知情同意 → 执行医疗干预。
// 整个链路在玩家视角中被渲染为"两束光 + 两次上视"。
//
// 为什么是垂直眼动而非眨眼？
// 闭锁综合征水平眼动丧失（CN VI在脑桥损害），
// 但垂直眼动保留（CN III/IV在中脑，位于脑桥病变上方）。
// 这是闭锁综合征患者唯一可靠的自主输出通道。
//
// 如果玩家长时间下视：系统会以为玩家"走了"，
// 然后有温柔的"……我明白了"，但光不会消失——最终还是会救。
// 这是叙事选择，不是game over。

* [眼睛向上看两次] -> consent_yes
* [眼睛向下看，不抬起] -> consent_no

= consent_yes =

// 短暂的沉默。
// 然后那个声音——第一次有了一丝情绪。
// 像一个医生在急诊室里，终于确认了
// 这个被误认为昏迷的患者确实能通过垂直眼动回应——
// 那种克制住的、轻轻的、释然。

~ consent_given = true

System: "好。"
System: "我们来了。"

-> phase_6_reperfusion

= consent_no =

// 玩家眼睛向下看。
// 沉默。
// 光没有消失。

System: "……我明白了。"

// 更长的沉默。
// 但光还在。影子还在。

System: "时间不多了。我们不会放弃。"

// 光渐渐变暖。不是强迫——是等待。
// 最终，玩家抬起眼。光还在。

System: "……你还在。我们也在。"
System: "准备好了吗？"

* [眼睛向上看两次] -> consent_yes

// ═══════════════════════════════════════════════════════════════
// PHASE 6: 再灌注（Reperfusion）
// ═══════════════════════════════════════════════════════════════

== phase_6_reperfusion ==
= flood =

// 天，打开了。
// 缺血区域的主供能管道，被从"外面"打通了。

// 洪流。
// 温暖的、富含能量的血液——在碳基赛博空间里读作"能量洪流"——
// 沿着主管道汹涌而入。

// 灯，一盏接一盏地亮了。
// 不是慢慢亮——是"轰"的一下，整条走廊、整个穹顶、整片区域，
// 像被点燃一样，全亮了。

// 绿色的生物荧光——健康的、充满活力的绿色。

~ regulation_level = 7
~ terminal_status = "recovering"
~ can_interact = true

// 玩家感觉意识调控力回来了。
// 不是慢慢恢复——是潮水一样涌回来。
// 视野重新清晰。突触终端重新浮现。能调控了。

// 周围——细胞们。
// 它们从各个角落里涌出来。从管道后面、从膜结构的缝隙里、
// 从神经元的树突之间——涌出来，仰头看着光。
// 欢呼声。不是人类的语言——是某种更原始的、生物的、劫后余生的欢腾。

// ─── 然后，洪流带来了新的身影 ───

// 不是这片区域的常驻细胞——是从外面来的。
// 它们随着再灌注的血流涌入，像援军抵达战场。
// 气质和Eiko明显不同——更大、更规整、动作带着目的性，
// 像读过了任务简报才来的。

// 其中一个穿过人群，径直走向Eiko。

~ yukio_met = true

// Eiko看到她。愣住了。
// 两个人——两个本不该相遇的人——隔着欢腾的细胞群对视。
// 一个在脑里待了一辈子，从灾难第一分钟就开始独自战斗。
// 一个从外面来，穿过崩塌的屏障，带着整个外周免疫系统的情报抵达。

Eiko: "……你来了。"

Yukio: "屏障塌了。我才能进来。"

// Yukio转向玩家。她的眼神和Eiko不同——
// Eiko的亮是活化的、焦灼的、三天没合眼的那种亮；
// Yukio的沉是评估过全局后的、知道最坏情况的、依然选择走进来的那种沉。

// 她没有自我介绍。她在看那些细胞——
// 看它们如何转向玩家，如何低语。

// 低语声，从四面八方传来：

Cells: "Admin……"
Cells: "Admin同意了……"
Cells: "是Admin让他们进来的……"

~ admin_revealed = true

// Eiko僵住了。她看看那些细胞，又看看玩家。

Eiko: "它们叫你……Admin？"

// 她的声音在发抖。不是害怕——是某种更大的东西。

Eiko: "我就知道。我第一眼看到你的时候就知道——"
Eiko: "你不是普通的单元。你是……"

-> damage

= damage =

// 她没说完。
// 因为——最亮的那片区域里，有个细胞爆炸了。

// 不是灯灭了的那种熄灭。是爆炸。
// 细胞膜破裂，内容物喷出来，荧光四溅。

// 然后是第二个。第三个。第十个。第一百个。
// 像鞭炮一样，沿着刚刚恢复供血的主干道，一个接一个的细胞在破裂。

// 警报——新的警报。不是缺血的琥珀色，是另一种红色警报。

{alert("✕ 紧急", "活性氧爆发 — 氧化应激")}
{alert("✕ 紧急", "钙超载 — 膜完整性丧失")}
{alert("✕ 紧急", "炎症级联 — 补体系统激活")}

// Eiko的笑容凝固在脸上。

Eiko: "不……"

// 她冲向最近的一个正在破裂的细胞——但已经晚了。
// 细胞在她面前碎掉了。

// Yukio变了脸色。她快步走向主干道，
// 蹲下查看一个正在膨胀的细胞——膜上布满了氧化损伤的斑点。

Yukio: "再灌注损伤。"
Yukio: "它们撑过了缺血——但撑不过血流回来的这一刻。"

// 远处，更多的细胞在爆炸。像一场新的、更猛烈的雪崩。

// 光还在。外面的影子还在。
// 但它们似乎也没预料到——或者预料到了，但无能为力。
// 那个声音再次响起，带着一丝沉重。

System: "……我们打通了路。但路的那头，还要靠你们自己。"
System: "保护它们。你有Admin调控权——你能做的事，比你想象的多。"

// 光渐渐退去。影子升回天穹之上。
// 膜结构重新闭合。
// 但留下了——重新流动的能量管道、正在爆炸的细胞、Admin调控权。

// Eiko转向玩家。
// 她脸上还有未干的泪痕，还有惊慌。
// 但眼底有什么东西——重新燃起来了。

Eiko: "你听到了。你有Admin调控权。"
Eiko: "我救了三天救不了的东西——但你能。"

-> phase_7_departure

// ═══════════════════════════════════════════════════════════════
// PHASE 7: 出发（Departure）
// ═══════════════════════════════════════════════════════════════

== phase_7_departure ==

// Eiko拉住玩家（玩家的意识投射体）。
// 突触终端界面正在重新浮现——
// 这一次，不是意识模式的暗淡绿色，
// 是明亮的、完整的、Admin级别的生物荧光。

~ terminal_status = "full"

Eiko: "走。还有的救。"

// Yukio跟上前来。她看了Eiko一眼，又看了玩家一眼。
// 然后开口了——声音不高，但每个字都像经过了精确计算。

Yukio: "Yukio。辅助性T细胞。"
Yukio: "外面的屏障塌了，我才能进来。"

// 她没有解释更多——但Eiko的表情微妙地变了一下。
// 像是想说"你怎么才来"，又咽了回去，变成了"你来了就好"。

// 玩家跟随Eiko和Yukio，冲向再灌注损伤最严重的区域。
// 沿途，细胞们让开一条路。
// 它们看着玩家——不是看一个陌生人，是看一个它们以为已经失去的人。

Yukio: "这片区域是脑桥供血区——你可以理解为一个街区。"
Yukio: "一个刚死里逃生、但还在着火的街区。"

Eiko: "你刚才做的事——眼睛上看了两次——那叫'同意'。"
Eiko: "外面那些人需要你的同意才能进来。但进来之后，剩下的要靠我们自己。"

Yukio: "缺血损伤我从外面已经看到了。再灌注损伤——"

// 她看向远处正在爆炸的细胞群，脚步没有停。

Yukio: "——才刚开始。"

// Eiko回头看了玩家一眼。
// 那个在黑暗中奋战了三天的、眼睛发亮的小胶质细胞——
// 她的赛丽亚式笑容又回来了。带着点倔强，带着点火气。

Eiko: "不管你是谁。不管你记不记得自己为什么叫Admin。"
Eiko: "你同意救我们——现在，跟我们一起把这事做完。"

// 镜头缓缓拉远——玩家、Eiko和Yukio三个身影穿过巨大的有机走廊，
// 冲向远方闪烁的红色警报。
// 走廊两侧是正在恢复、但也在不断爆炸的细胞结构。
// 荧光像星星一样一颗颗亮起，又像烟花一样一颗颗熄灭。
// 更多的黑暗区域等待着。更多的战场等待着。

// 画面渐黑。

// 标题浮现：

//   SoMe

// 副标题，逐字出现：

//   梦 游 者

// 开场结束。玩家进入开放世界。

-> END

// ═══════════════════════════════════════════════════════════════
// DESIGN NOTES — Ink结构说明
// ═══════════════════════════════════════════════════════════════
//
// 1. KNOT结构
//    - 每个Phase是一个knot（== phase_N ==）
//    - Phase内子场景用stitch（= stitch_name =）
//    - 主线通过divert（->）串联，分支用choice（*）实现
//
// 2. 状态追踪
//    - regulation_level: 调控等级，映射闭锁+缺血级联各阶段
//      0=闭锁 → 1=意识感知 → 2=侧支循环 → 3=糖酵解 → 4=雪崩 → 5=仅眼动 → 6=BCI连接 → 7=再灌注
//    - terminal_status: 突触终端（意识投射界面）状态
//      offline → emerging → full → lagging → flickering → offline → recovering → full
//    - can_move: 始终false（闭锁状态，身体不能动）
//    - can_interact: 意识级交互能力（随缺血恶化→丧失→BCI恢复）
//    - can_blink: 垂直眼动（CN III/IV保留，始终true）
//    - misdiagnosed: 是否已被误诊为昏迷
//    - React端读取这些变量控制UI可用性
//
// 3. 闭锁综合征核心体验
//    - can_move=false贯穿全场：玩家身体不能动（脑桥基底部梗死）
//    - 玩家通过"意识级Admin调控"影响细胞世界（非物理操作）
//    - 唯一自主输出=垂直眼动（CN III/IV在中脑保留）
//    - 水平眼动丧失（CN VI在脑桥损害）——不使用水平方向的选择
//    - "误诊为昏迷"是Phase 1-4的核心戏剧冲突
//    - EEG正常/轻度慢波→排除真性昏迷（Phase 4）
//    - 垂直眼动检查→确诊闭锁综合征（Phase 4）
//
// 4. 碳基术语双标签
//    - dual("碳基术语", "硅基等价") 函数输出 "碳基术语（硅基等价）"
//    - React端解析（）内的内容，可选择：
//      a) 行内显示：染色质可及性（权限）
//      b) 上下堆叠：染色质可及性 / 权限（小字）
//    - 系统警报中大量使用
//
// 5. 垂直眼动同意机制（Phase 5）
//    - Ink choice映射为两束光（上/下）
//    - React端可接入眼动追踪（移动端用摄像头，桌面端用鼠标上滑/下滑模拟）
//    - 同意=眼睛上视两次；拒绝=眼睛下视不动
//    - 拒绝路径不是game over——是叙事选择，最终仍会推进
//    - 垂直眼动而非眨眼：CN III/IV在中脑保留 vs CN VI在脑桥损害
//
// 6. 意识级调控降级
//    - regulation_level + terminal_status变量驱动
//    - React端根据变量值控制：
//      · can_interact=false时禁用突触终端交互
//      · terminal_status=offline时隐藏突触终端UI
//      · can_blink=true时仅显示垂直眼动交互
//    - 玩家的意识调控限制本身就是剧情——缺血级联的亲身体验
//    - 与v1的区别：降级的是意识调控能力，不是运动能力（运动从一开始就是0）
//
// 7. 多角色对话
//    - Speaker: "text" 格式，React端可按speaker分配不同样式
//    - Eiko: 暖色系（小胶质细胞荧光）
//    - Yukio: 冷色系（T细胞/外周免疫）
//    - System: BCI声音——特殊样式（清晰、直接在意识中）
//    - ICU_A / ICU_B: 外部医护——闷响、隔膜感（BCI连接前）
//    - Cells: 集体低语——小字、多行、渐显
//
// 8. React集成方式
//    - npm install inkjs
//    - 编译：inklecate Opening_Sequence.ink → Opening_Sequence.ink.json
//    - 加载：inkjs加载.json，React订阅story状态更新
//    - 渲染：React根据speaker/变量/标记自定义渲染每个内容块
//
// 9. Godot迁移路径
//    - ink-godot插件加载同一份.ink.json
//    - Godot端用RichTextLabel或自定义节点渲染
//    - 状态变量通过ink-godot的API读写
//    - 原型React验证叙事 → 正式版Godot无需重写剧本
//
// ═══════════════════════════════════════════════════════════════
