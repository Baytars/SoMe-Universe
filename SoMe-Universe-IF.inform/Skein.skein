  <generator>Windows Inform 10.1.2</generator>
  <item nodeId="node-476">
    <command xml:space="preserve">SoMe-Universe-IF</command>
    <result xml:space="preserve">SoMe-Universe: The Ten Banners&#x000A;A diplomatic circuit through the Saga of Medicine by The SoMe-Universe Contributors&#x000A;Release 1 / Serial number 260921 / Inform 7 v10.1.2 / D&#x000A;&#x000A;Singularity&#x000A;You are in the Singularity. The universe is beginning to explode.&#x000A;&#x000A;Two gates swirl in the newborn light: the Hall of Medicine to the south, the Disease Citadel to the north. Ten powers wait behind them for the first envoy to walk the war.&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
    <children>
      <child nodeId="node-481"/>
      <child nodeId="node-477"/>
    </children>
  </item>
  <item nodeId="node-481">
    <command xml:space="preserve">n</command>
    <result xml:space="preserve">Disease Citadel&#x000A;The Disease Citadel is where diseases are born. Here you can see many patients being tortured by the diseases - and the five doors of the Unseen Crown open onto the dark: Archaeology, Fear Technology, the Pale Masquerade, the Undead Court, and the Abyssal fleet.&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
    <children>
      <child nodeId="node-482"/>
    </children>
  </item>
  <item nodeId="node-482">
    <command xml:space="preserve">go to undead court</command>
    <result xml:space="preserve">The concordance serves sworn envoys only; the gates demand an oath first. CHOOSE a patron in the Hall or the Citadel.&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
    <children>
      <child nodeId="node-483"/>
    </children>
  </item>
  <item nodeId="node-483">
    <command xml:space="preserve">choose disease citadel</command>
    <result xml:space="preserve">No such patron answers. The Hall offers the Cradle, the Celestial Corps, the Pantheon and the Martyrs; the Citadel offers Archaeology, Fear Technology, Pallidum, Rabies, Typhi and Vibrio.&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
    <children>
      <child nodeId="node-484"/>
    </children>
  </item>
