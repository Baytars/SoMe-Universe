    <command xml:space="preserve">ask Budapest about secret</command>
    <result xml:space="preserve">The Budapest Bride listens, and offers nothing on that.&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
    <children>
      <child nodeId="node-188"/>
    </children>
  </item>
