  <item nodeId="node-23">
    <command xml:space="preserve">choose citadel</command>
    <result xml:space="preserve">Those are the two gates, not a patron. The Citadel hosts six patrons (Archaeology, Fear Technology, Pallidum, Rabies, Typhi, Vibrio); the Hall hosts four (Cradle, Celestial Corps, Pantheon, Martyrs). Choose one of the ten.&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
  </item>
  <item nodeId="node-24">
    <command xml:space="preserve">choose disease citadel</command>
    <result xml:space="preserve">No such patron answers. The Hall offers the Cradle, the Celestial Corps, the Pantheon and the Martyrs; the Citadel offers Archaeology, Fear Technology, Pallidum, Rabies, Typhi and Vibrio.&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
    <children>
      <child nodeId="node-25"/>
    </children>
  </item>
  <item nodeId="node-25">
    <command xml:space="preserve">choose Typhi</command>
    <result xml:space="preserve">No such patron answers. The Hall offers the Cradle, the Celestial Corps, the Pantheon and the Martyrs; the Citadel offers Archaeology, Fear Technology, Pallidum, Rabies, Typhi and Vibrio.&#x000A;&#x000A;&gt;</result>
